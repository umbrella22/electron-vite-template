{
  "name": "electron-vite-template",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "description": "electron-vite-template monorepo",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node tools/build/dev-runner.ts",
    "build": "vp run --cache desktop#build && cd apps/desktop && electron-builder -c build.json",
    "build:win32": "vp run --cache desktop#build && cd apps/desktop && electron-builder -c build.json --win --ia32",
    "build:win64": "vp run --cache desktop#build && cd apps/desktop && electron-builder -c build.json --win --x64",
    "build:mac": "vp run --cache desktop#build && cd apps/desktop && electron-builder -c build.json --mac",
    "build:dir": "vp run --cache desktop#build && cd apps/desktop && electron-builder -c build.json --dir",
    "build:clean": "node tools/build/tasks/clean.ts",
    "build:web": "node tools/build/tasks/build-renderer.ts --target web",
    "pack:resources": "node tools/build/tasks/hot-update.ts",
    "format": "vp fmt",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "adm-zip": "^0.6.1",
    "cfonts": "^3.3.1",
    "chalk": "^6.0.1",
    "del": "^9.0.1",
    "detect-port": "^2.1.0",
    "dotenv": "^18.0.5",
    "electron": "44.5.1",
    "electron-builder": "^26.17.0",
    "fs-extra": "^11.3.0",
    "minimist": "^1.2.8",
    "rolldown": "^1.2.12",
    "sass": "^1.105.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite-plus": "^1.1.0"
  },
  "keywords": [
    "vite",
    "electron",
    "vue3",
    "monorepo"
  ],
  "engines": {
    "node": ">=24"
  }
}