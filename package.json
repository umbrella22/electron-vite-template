{
  "name": "electron-vite-template",
  "version": "1.0.0",
  "main": "./dist/electron/main/main.mjs",
  "author": "sky <https://github.com/umbrella22>",
  "description": "electron-vite-template project",
  "license": "MIT",
  "type": "module",
  "encryptionLevel": 1,
  "scripts": {
    "dev": "tsx .electron-vite/dev-runner.ts",
    "build": "tsx .electron-vite/build.ts -m prod && electron-builder -c build.json",
    "build:win32": "tsx .electron-vite/build.ts -m prod  && electron-builder -c build.json --win  --ia32",
    "build:win64": "tsx .electron-vite/build.ts -m prod  && electron-builder -c build.json --win  --x64",
    "build:mac": "tsx .electron-vite/build.ts -m prod  && electron-builder -c build.json --mac",
    "build:dir": "tsx .electron-vite/build.ts -m prod  && electron-builder -c build.json --dir",
    "build:clean": "tsx .electron-vite/build.ts --clean",
    "build:web": "tsx .electron-vite/build.ts",
    "pack:resources": "tsx .electron-vite/hot-updater.ts",
    "format": "vp fmt",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "regedit": "^5.1.4",
    "semver": "^7.7.2",
    "electron-store": "^11.0.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.19.1",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "adm-zip": "^0.6.1",
    "axios": "^1.13.2",
    "cfonts": "^3.3.1",
    "chalk": "^6.0.1",
    "del": "^8.0.1",
    "detect-port": "^2.1.0",
    "dotenv": "^18.0.5",
    "electron": "^44.5.1",
    "electron_updater_node_cli": "^0.3.3",
    "electron_updater_node_core": "^0.3.3",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "element-plus": "^2.14.7",
    "fs-extra": "^11.3.0",
    "listr2": "^11.1.1",
    "minimist": "^1.2.8",
    "pinia": "^4.0.3",
    "rolldown": "^1.2.12",
    "sass": "^1.105.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0",
    "vue": "^3.5.24",
    "vue-i18n": "^11.1.12",
    "vue-router": "^5.3.1"
  },
  "keywords": [
    "vite",
    "electron",
    "vue3",
    "rollup"
  ]
}
